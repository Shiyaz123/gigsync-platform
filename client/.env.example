# GigSync Frontend Environment Variables
# If deploying frontend and backend as separate services (e.g. Vercel + Render/Railway/Fly):
# Set VITE_API_URL to your backend API URL.
# Example: VITE_API_URL=https://api.gigsync.com
# If omitted or left empty, the frontend defaults to relative '/api' (handled by proxy or same-origin rewrite).
VITE_API_URL=
