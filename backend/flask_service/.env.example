# GigSync Flask Job Search & Resume Matching Service
# Environment Configuration Template

# Server Configuration
FLASK_PORT=5001
FLASK_HOST=0.0.0.0
FLASK_DEBUG=false

# Allowed CORS Origins (comma-separated, or * for all)
CORS_ORIGINS=http://localhost:3000,http://localhost:5000,https://gigsync-platform.vercel.app

# Real Job Provider Credentials:
# 1. Adzuna API (Global country-specific job search, e.g. India, US, UK, Canada, Australia)
# Obtain free developer credentials at: https://developer.adzuna.com/
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here

# 2. The Muse API (Software Engineering jobs)
# Free public developer API. Key is optional for increased rate limits.
# Obtain at: https://www.themuse.com/developers/api/v2
THE_MUSE_API_KEY=your_muse_api_key_optional
